{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "learning-forge pedagogy",
  "type": "object",
  "required": [
    "topic",
    "objective",
    "misconceptions",
    "analogies",
    "claims",
    "sources"
  ],
  "properties": {
    "topic": {
      "type": "string"
    },
    "audience": {
      "type": "string"
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "objective": {
      "type": "string",
      "description": "a DOING: 'can write / can explain / can spot'"
    },
    "misconceptions": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "belief",
          "reality"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "belief": {
            "type": "string"
          },
          "reality": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "analogies": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "analogy",
          "maps_to",
          "why_it_works",
          "where_it_breaks"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "analogy": {
            "type": "string"
          },
          "maps_to": {
            "type": "string"
          },
          "why_it_works": {
            "type": "string"
          },
          "where_it_breaks": {
            "type": "string"
          }
        }
      }
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "code",
          "demonstrates"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "demonstrates": {
            "type": "string"
          }
        }
      }
    },
    "visualizable_moments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claims": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "authority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        }
      }
    }
  }
}