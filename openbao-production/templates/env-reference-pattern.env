# .env template with OpenBao secret references
# This file is committed to git. Actual values come from OpenBao at runtime.
# To resolve: $ ./scripts/get-secret.sh <namespace> <kv-path>

# OpenBao References - these are PATHS, NOT values
# Runtime resolves these by calling the OpenBao API.

# JWT / Auth
JWT_SECRET=*** # Source: iacgenie/kv/data/jwt/secret

# Redis
REDIS_PASSWORD=*** # Source: iacgenie/kv/data/redis/password

# PostgreSQL
POSTGRES_APP_USER=***
POSTGRES_APP_PASSWORD=*** # Source: iacgenie/kv/data/postgres/app
POSTGRES_SUPER_PASSWORD=*** # Source: iacgenie/kv/data/postgres/super
POSTGRES_KC_PASSWORD=*** # Source: iacgenie/kv/data/postgres/kc

# MinIO
MINIO_ROOT_USER=***
MINIO_ROOT_PASSWORD=*** # Source: iacgenie/kv/data/minio

# Cloudflare
CLOUDFLARE_API_KEY=*** # Source: iacgenie/kv/data/cloudflare/tunnel

# Gemini / AI
GEMINI_API_KEY=*** # Source: iacgenie/kv/data/gemini/api

# Gitea
GITEA_ADMIN_TOKEN=*** # Source: iacgenie/kv/data/gitea/admin

# Google OAuth
GOOGLE_CLIENT_ID=***
GOOGLE_CLIENT_SECRET=*** # Source: iacgenie/kv/data/google/client

# Keycloak
KEYCLOAK_ADMIN_USER=***
KEYCLOAK_ADMIN_PASSWORD=*** # Source: iacgenie/kv/data/keycloak/admin

# Sentry
SENTRY_DSN=*** # Source: iacgenie/kv/data/sentry/dsn

# SMTP
SMTP2GO_API_KEY=***
S...=*** # Source: iacgenie/kv/data/smtp2go/api_key / username

# Vite
VITE_API_KEY=***
V...=*** # Source: iacgenie/kv/data/vite/api / frontend

# LightSerp specific
LIGHTSERP_DB_PASSWORD=*** # Source: lightserp/kv/data/postgres/password
LIGHTSERP_OPENBAO_TOKEN=*** # Source: lightserp/kv/data/openbao/root_token
LIGHTSERP_JWT_SECRET=*** # Source: lightserp/kv/data/jwt/secret

# Terraform specific
TERRAFORM_DB_PASSWORD=*** # Source: terraform/kv/data/postgres/password
TERRAFORM_MINIO_ACCESS_KEY=***
TERRAFORM_MINIO_SECRET_KEY=*** # Source: terraform/kv/data/minio
TERRAFORM_CLOUDFLARE_API_KEY=*** # Source: terraform/kv/data/cloudflare/api_key

# OpenBao service token (read-only)
OPENBAO_SERVICE_TOKEN=*** # Source: iacgenie/kv/data/openbao/token

# Non-secret config (safe to hardcode)
DOMAIN=iacgenie.com
NODE_ENV=production
LOG_LEVEL=info
APP_PORT=3000
